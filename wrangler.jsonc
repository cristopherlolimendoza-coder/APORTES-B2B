{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "honor-aportes-b2bpagesdev",
  "compatibility_date": "2026-10-14",
  "main": "./src/index-v10.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/kam-20261026.js", "/", "/index.html"]
  },
  "durable_objects": {
    "bindings": [{
      "name": "APORTES_DB",
      "class_name": "AportesDB"
    }]
  },
  "migrations": [{
    "tag": "v1_sqlite",
    "new_sqlite_classes": ["AportesDB"]
  }]
}
